@model List<ApplicationUser>
@{
    ViewData["Title"] = "Người dùng";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <form method="get" class="d-flex gap-2">
        <input type="text" name="tuKhoa" class="form-control" placeholder="Tìm theo tên/email..." value="@ViewBag.TuKhoa" style="width:280px;" />
        <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
    </form>
    <span class="text-muted small">@Model.Count người dùng</span>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table admin-table table-hover mb-0">
            <thead>
                <tr>
                    <th>Họ tên</th>
                    <th>Email</th>
                    <th>Ngày tạo</th>
                    <th>Premium</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>@u.HoTen</td>
                        <td>@u.Email</td>
                        <td>@u.NgayTao.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (u.PremiumConHieuLuc)
                            { <span class="badge-premium"><i class="bi bi-stars"></i> Đến @u.PremiumHetHan?.ToString("dd/MM/yyyy")</span> }
                            else
                            { <span class="badge bg-secondary">Miễn phí</span> }
                        </td>
                        <td class="text-center">
                            <div class="d-flex gap-1 justify-content-center">
                                <a asp-action="Details" asp-route-id="@u.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a>
                                <form asp-action="Xoa" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa vĩnh viễn tài khoản \'@u.Email\'? Toàn bộ giao dịch, danh mục, hóa đơn... của người dùng này cũng sẽ bị xóa và KHÔNG THỂ khôi phục.');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">Không tìm thấy người dùng nào</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
