@inject MoneyCare.Web.Services.ICurrentUserService CurrentUserService
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản trị MoneyCare</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/admin.css" />
</head>
<body class="admin-body">
@{
    var adminUser = await CurrentUserService.GetAppUserAsync();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<div class="admin-shell">
    <aside class="admin-sidebar">
        <div class="admin-brand">
            <span class="admin-brand-mark"><i class="bi bi-shield-lock-fill"></i></span>
            <div>
                <div class="admin-brand-text">Admin Panel</div>
                <div class="admin-brand-sub">MoneyCare</div>
            </div>
        </div>

        <nav class="admin-nav">
            <a class="admin-nav-link @(currentController == "AdminHome" ? "active" : "")" asp-area="Admin" asp-controller="AdminHome" asp-action="Index">
                <i class="bi bi-speedometer2"></i><span>Dashboard</span>
            </a>
            <a class="admin-nav-link @(currentController == "Users" ? "active" : "")" asp-area="Admin" asp-controller="Users" asp-action="Index">
                <i class="bi bi-people"></i><span>Người dùng</span>
            </a>
            <a class="admin-nav-link @(currentController == "PremiumOrders" ? "active" : "")" asp-area="Admin" asp-controller="PremiumOrders" asp-action="Index">
                <i class="bi bi-stars"></i><span>Đơn Premium</span>
            </a>
            <a class="admin-nav-link @(currentController == "Households" ? "active" : "")" asp-area="Admin" asp-controller="Households" asp-action="Index">
                <i class="bi bi-house-heart"></i><span>Hộ gia đình</span>
            </a>
            <a class="admin-nav-link @(currentController == "ContactMessages" ? "active" : "")" asp-area="Admin" asp-controller="ContactMessages" asp-action="Index">
                <i class="bi bi-envelope-heart"></i><span>Liên hệ & Góp ý</span>
            </a>
        </nav>

        <a asp-area="" asp-controller="Home" asp-action="Index" class="admin-back-link">
            <i class="bi bi-box-arrow-left"></i> Quay lại ứng dụng
        </a>
    </aside>

    <div class="admin-main">
        <header class="admin-topbar">
            <h1 class="admin-page-title">@ViewData["Title"]</h1>
            <div class="d-flex align-items-center gap-2">
                <span class="admin-role-badge"><i class="bi bi-shield-check"></i> Admin</span>
                <span class="text-muted small">@(adminUser?.HoTen ?? adminUser?.Email)</span>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-box-arrow-right"></i></button>
                </form>
            </div>
        </header>
        <main class="admin-content">
            @if (TempData["ThongBao"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="bi bi-check-circle"></i> @TempData["ThongBao"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Loi"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    <i class="bi bi-exclamation-triangle"></i> @TempData["Loi"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
