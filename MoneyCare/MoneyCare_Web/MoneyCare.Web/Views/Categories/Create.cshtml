@model Category
@{
    ViewData["Title"] = "Thêm danh mục";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-white"><i class="bi bi-plus-lg"></i> Thêm danh mục mới</div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                    <div class="mb-3">
                        <label asp-for="TenDanhMuc" class="form-label"></label>
                        <input asp-for="TenDanhMuc" class="form-control" autofocus />
                        <span asp-validation-for="TenDanhMuc" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Loai" class="form-label"></label>
                        <select asp-for="Loai" class="form-select" asp-items="Html.GetEnumSelectList<LoaiGiaoDich>()"></select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="MauSac" class="form-label"></label>
                        <input asp-for="MauSac" type="color" class="form-control form-control-color" />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Lưu</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
