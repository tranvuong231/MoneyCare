@{
    ViewData["Title"] = "Tham gia hộ gia đình";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card">
            <div class="card-header">Tham gia hộ gia đình</div>
            <div class="card-body">
                <form method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                    <div class="mb-3">
                        <label class="form-label">Mã mời (6 ký tự)</label>
                        <input type="text" name="maMoi" class="form-control text-uppercase" maxlength="10" placeholder="VD: A1B2C3" autofocus />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Tham gia</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
