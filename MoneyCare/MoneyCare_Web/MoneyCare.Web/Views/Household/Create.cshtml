@{
    ViewData["Title"] = "Tạo hộ gia đình";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card">
            <div class="card-header">Tạo hộ gia đình mới</div>
            <div class="card-body">
                <form method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                    <div class="mb-3">
                        <label class="form-label">Tên hộ gia đình</label>
                        <input type="text" name="tenHoGiaDinh" class="form-control" placeholder="VD: Gia đình Nguyễn Văn A" autofocus />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Tạo hộ gia đình</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
