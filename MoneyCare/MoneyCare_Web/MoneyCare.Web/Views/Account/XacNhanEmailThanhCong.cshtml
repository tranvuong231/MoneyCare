@{
    ViewData["Title"] = "Xác minh Email";
    Layout = "_Layout";
}

<div class="auth-page">
    <div class="auth-card text-center">
        <i class="bi bi-patch-check-fill text-primary" style="font-size:3rem;"></i>
        <h3 class="auth-title mt-2">Xác minh Email thành công!</h3>
        <p class="auth-subtitle">Tài khoản của bạn giờ đã có tích xanh xác minh danh tính.</p>
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary w-100 py-2">Đăng nhập</a>
    </div>
</div>
