@{
    ViewData["Title"] = "Thành công";
    Layout = "_Layout";
}

<div class="auth-page">
    <div class="auth-card text-center">
        <i class="bi bi-check-circle text-success" style="font-size:3rem;"></i>
        <h3 class="auth-title mt-2">Đặt lại mật khẩu thành công!</h3>
        <p class="auth-subtitle">Bạn có thể đăng nhập bằng mật khẩu mới ngay bây giờ.</p>
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary w-100 py-2">Đăng nhập</a>
    </div>
</div>
