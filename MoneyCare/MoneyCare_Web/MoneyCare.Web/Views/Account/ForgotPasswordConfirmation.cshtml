@{
    ViewData["Title"] = "Đã gửi yêu cầu";
    Layout = "_Layout";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-brand">
            <span class="brand-mark"><i class="bi bi-wallet2"></i></span>
            <span class="brand-text">MoneyCare</span>
        </div>
        <div class="text-center">
            <i class="bi bi-envelope-check text-success" style="font-size:3rem;"></i>
            <h3 class="auth-title mt-2">Kiểm tra email của bạn</h3>
            <p class="auth-subtitle">
                Nếu email tồn tại trong hệ thống, chúng tôi đã gửi hướng dẫn đặt lại mật khẩu tới hộp thư của bạn.
            </p>
        </div>

        @if (TempData["MaDemo"] != null)
        {
            <div class="alert alert-warning small">
                <i class="bi bi-info-circle"></i> <strong>Chế độ demo:</strong> Chưa cấu hình SMTP gửi email thật,
                đây là mã xác nhận (thực tế sẽ được gửi qua email): <strong>@TempData["MaDemo"]</strong>
            </div>
        }

        <a asp-controller="Account" asp-action="ResetPassword" asp-route-email="@TempData.Peek("EmailChoDatLai")" class="btn btn-primary w-100 py-2">Nhập mã xác nhận</a>
    </div>
</div>
