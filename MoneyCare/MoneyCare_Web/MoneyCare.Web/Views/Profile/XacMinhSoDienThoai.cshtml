@model XacMinhOtpViewModel
@{
    ViewData["Title"] = "Xác minh số điện thoại";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header"><i class="bi bi-shield-check"></i> Xác minh số điện thoại</div>
            <div class="card-body">
                <p class="text-muted">
                    Mã xác minh cho số <strong>@TempData.Peek("SoDienThoaiChoXacMinh")</strong> đã được gửi tới email của bạn, vui lòng kiểm tra hộp thư.
                </p>

                @if (TempData["OtpDemo"] != null)
                {
                    <div class="alert alert-warning small">
                        <i class="bi bi-info-circle"></i> <strong>Chưa gửi được email thật:</strong> @TempData["GhiChuDemo"]<br />
                        Mã OTP của bạn là: <strong class="fs-5">@TempData["OtpDemo"]</strong>
                    </div>
                }

                <form asp-action="XacMinhSoDienThoai" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                    <div class="mb-3">
                        <label asp-for="MaOtp" class="form-label"></label>
                        <input asp-for="MaOtp" class="form-control" autofocus />
                        <span asp-validation-for="MaOtp" class="text-danger"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Xác minh</button>
                        <a asp-action="ThemSoDienThoai" class="btn btn-outline-secondary">Nhập lại số khác</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
