@model ThemSoDienThoaiViewModel
@{
    ViewData["Title"] = ViewBag.SoHienTai != null ? "Đổi số điện thoại" : "Thêm số điện thoại";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header"><i class="bi bi-telephone-plus"></i> @ViewData["Title"]</div>
            <div class="card-body">
                @if (ViewBag.SoHienTai != null)
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        Số hiện tại: <strong>@ViewBag.SoHienTai</strong>. Đổi sang số mới sẽ cần xác minh lại -
                        nếu tài khoản đang có tích xanh, tích xanh sẽ <strong>tạm mất</strong> cho tới khi xác minh xong số mới.
                    </div>
                }
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i>
                    Sau khi xác minh số điện thoại thành công và đủ điều kiện tích xanh (đã xác minh cả Email),
                    bạn sẽ <strong>không thể sửa họ và tên</strong> nữa.
                </div>

                <form asp-action="ThemSoDienThoai" method="post" id="formThemSdt">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                    <div class="mb-3">
                        <label asp-for="SoDienThoai" class="form-label"></label>
                        <input asp-for="SoDienThoai" class="form-control" placeholder="VD: 0912345678" autofocus />
                        <span asp-validation-for="SoDienThoai" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-3">
                        <!--
                            data-val="false": TẮT client-validation tự động của thẻ này.
                            Lý do: [Range(typeof(bool), "true", "true")] dùng để bắt buộc tick checkbox có
                            một lỗi tương thích đã biết giữa ASP.NET Core và jQuery Validate - giá trị JS gửi
                            lên là "true" (chữ thường) nhưng bộ so sánh unobtrusive lại so với "True" (viết
                            hoa), khiến ô luôn bị báo "chưa hợp lệ" DÙ ĐÃ TICK, chặn không submit được form.
                            Attribute [Range] vẫn giữ lại để validate phía SERVER (phòng trường hợp tắt JS);
                            phía client dùng đoạn script nhỏ bên dưới để kiểm tra thay thế cho đáng tin cậy.
                        -->
                        <input asp-for="DaXacNhanCanhBao" class="form-check-input" data-val="false" id="chkCanhBao" />
                        <label asp-for="DaXacNhanCanhBao" class="form-check-label"></label>
                        <span id="loiCanhBao" class="text-danger" style="display:none;">Bạn cần xác nhận đã đọc cảnh báo trước khi tiếp tục</span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i> Gửi mã xác minh</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('formThemSdt').addEventListener('submit', function (e) {
        var chk = document.getElementById('chkCanhBao');
        var loi = document.getElementById('loiCanhBao');
        if (!chk.checked) {
            e.preventDefault();
            loi.style.display = 'block';
            chk.focus();
        } else {
            loi.style.display = 'none';
        }
    });
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
