@model ContactViewModel
@{
    ViewData["Title"] = "Liên hệ & Đóng góp";
    var daDangNhap = User.Identity?.IsAuthenticated == true;
}

@if (!daDangNhap)
{
    <div class="auth-page">
        <div class="auth-card auth-card-wide">
            <div class="auth-brand">
                <span class="brand-mark"><i class="bi bi-wallet2"></i></span>
                <span class="brand-text">MoneyCare</span>
            </div>
            <h3 class="auth-title">Liên hệ &amp; Đóng góp</h3>
            <p class="auth-subtitle">Mọi góp ý của bạn đều giúp MoneyCare tốt hơn mỗi ngày.</p>
            <partial name="_ContactForm" model="Model" />
            <p class="text-center mt-4 mb-0">
                <a asp-controller="Home" asp-action="Index">← Quay lại trang chủ</a>
            </p>
        </div>
    </div>
}
else
{
    <div class="row justify-content-center">
        <div class="col-md-7">
            <h4 class="mb-1"><i class="bi bi-envelope-heart"></i> Liên hệ &amp; Đóng góp</h4>
            <p class="text-muted mb-4">Mọi góp ý của bạn đều giúp MoneyCare tốt hơn mỗi ngày.</p>
            <div class="card">
                <div class="card-body">
                    <partial name="_ContactForm" model="Model" />
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
