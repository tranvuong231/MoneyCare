@model List<ThongBao>
@{
    ViewData["Title"] = "Thông báo";
    var soChuaXem = Model.Count(t => !t.DaXem);

    string IconTheoLoai(LoaiThongBao loai) => loai switch
    {
        LoaiThongBao.HoaDon => "bi-calendar-event",
        LoaiThongBao.PhanTichAI => "bi-stars",
        LoaiThongBao.BaoCao => "bi-bar-chart",
        LoaiThongBao.XacMinh => "bi-patch-check",
        LoaiThongBao.HoSo => "bi-person",
        LoaiThongBao.HoGiaDinh => "bi-people",
        LoaiThongBao.Premium => "bi-stars",
        _ => "bi-bell"
    };

    string MauTheoLoai(LoaiThongBao loai) => loai switch
    {
        LoaiThongBao.HoaDon => "text-warning",
        LoaiThongBao.PhanTichAI => "text-primary",
        LoaiThongBao.BaoCao => "text-info",
        LoaiThongBao.XacMinh => "text-success",
        LoaiThongBao.HoSo => "text-secondary",
        LoaiThongBao.HoGiaDinh => "text-teal",
        LoaiThongBao.Premium => "text-warning",
        _ => "text-muted"
    };

    string ThoiGianTruoc(DateTime t)
    {
        var ts = DateTime.Now - t;
        if (ts.TotalMinutes < 1) return "Vừa xong";
        if (ts.TotalMinutes < 60) return $"{(int)ts.TotalMinutes} phút trước";
        if (ts.TotalHours < 24) return $"{(int)ts.TotalHours} giờ trước";
        if (ts.TotalDays < 7) return $"{(int)ts.TotalDays} ngày trước";
        return t.ToString("dd/MM/yyyy");
    }
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-bell"></i> Thông báo @(soChuaXem > 0 ? $"({soChuaXem} chưa đọc)" : "")</h2>
    @if (soChuaXem > 0)
    {
        <form asp-action="DanhDauTatCaDaXem" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-secondary btn-sm"><i class="bi bi-check2-all"></i> Đọc tất cả</button>
        </form>
    }
</div>

<div class="d-flex flex-column gap-2">
    @foreach (var tb in Model)
    {
        <div class="card @(tb.DaXem ? "" : "border-primary")" style="@(tb.DaXem ? "" : "background:rgba(13,110,253,0.04);")">
            <div class="card-body d-flex align-items-start gap-3 py-3">
                <div class="fs-4 @MauTheoLoai(tb.Loai)"><i class="bi @IconTheoLoai(tb.Loai)"></i></div>
                <a asp-action="DiToi" asp-route-id="@tb.Id" class="flex-grow-1 text-decoration-none text-body" style="cursor:pointer;">
                    <div class="d-flex justify-content-between">
                        <strong class="@(tb.DaXem ? "" : "text-primary")">@tb.TieuDe</strong>
                        @if (!tb.DaXem)
                        {
                            <span class="badge bg-primary rounded-circle" style="width:8px;height:8px;padding:0;"></span>
                        }
                    </div>
                    <div class="small text-muted" style="white-space:pre-wrap;">@tb.NoiDung</div>
                    <div class="small text-muted mt-1">@ThoiGianTruoc(tb.NgayTao)</div>
                </a>
                <div class="dropdown">
                    <button class="btn btn-sm btn-light" data-bs-toggle="dropdown"><i class="bi bi-three-dots"></i></button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <form asp-action="@(tb.DaXem ? "DanhDauChuaXem" : "DanhDauDaXem")" asp-route-id="@tb.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item">
                                    <i class="bi bi-@(tb.DaXem ? "envelope" : "envelope-open") me-2"></i>
                                    Đánh dấu @(tb.DaXem ? "chưa đọc" : "đã đọc")
                                </button>
                            </form>
                        </li>
                        <li>
                            <form asp-action="Xoa" asp-route-id="@tb.Id" method="post" onsubmit="return confirm('Xóa thông báo này?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash me-2"></i>Xóa</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-bell-slash fs-1 d-block mb-2"></i>
            Chưa có thông báo nào
        </div>
    }
</div>
