@inject MoneyCare.Web.Services.ICurrentUserService CurrentUserService
@{
    var daDangNhap = User.Identity?.IsAuthenticated == true;
    var appUser = daDangNhap ? await CurrentUserService.GetAppUserAsync() : null;
    var laPremium = appUser?.PremiumConHieuLuc == true;
    var laAdmin = appUser != null && await CurrentUserService.LaAdminAsync();
    var soChuaXemThongBao = appUser != null ? await CurrentUserService.SoChuaXemThongBaoAsync() : 0;
}
<!DOCTYPE html>
<html lang="vi" data-theme="@(appUser?.GiaoDienToi == true ? "dark" : "light")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MoneyCare</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
@if (!daDangNhap)
{
    @RenderBody()
}
else
{
    <div class="app-shell">
        <aside class="sidebar" id="sidebar">
            <a class="sidebar-brand" asp-controller="Home" asp-action="Index" style="text-decoration:none;">
                <span class="brand-mark"><i class="bi bi-wallet2"></i></span>
                <span class="brand-text">MoneyCare</span>
            </a>

            <nav class="sidebar-nav">
                <div class="nav-section-label">Tổng quan</div>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2"></i><span>Tổng quan</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Transactions" ? "active" : "")" asp-controller="Transactions" asp-action="Index">
                    <i class="bi bi-arrow-left-right"></i><span>Giao dịch</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")" asp-controller="Categories" asp-action="Index">
                    <i class="bi bi-tags"></i><span>Danh mục</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Bills" ? "active" : "")" asp-controller="Bills" asp-action="Index">
                    <i class="bi bi-receipt"></i><span>Hóa đơn</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")" asp-controller="Reports" asp-action="Index">
                    <i class="bi bi-bar-chart"></i><span>Báo cáo</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Payment" ? "active" : "")" asp-controller="Payment" asp-action="Index">
                    <i class="bi bi-qr-code"></i><span>Thanh toán QR</span>
                </a>

                <div class="nav-section-label d-flex align-items-center gap-1 mt-3">
                    Premium <i class="bi bi-stars text-premium"></i>
                </div>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Insights" ? "active" : "")" asp-controller="Insights" asp-action="Index">
                    <i class="bi bi-cpu"></i><span>AI Phân tích</span>
                    @if (!laPremium) { <i class="bi bi-lock-fill lock-icon"></i> }
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Ocr" ? "active" : "")" asp-controller="Ocr" asp-action="Index">
                    <i class="bi bi-camera"></i><span>Quét hóa đơn</span>
                    @if (!laPremium) { <i class="bi bi-lock-fill lock-icon"></i> }
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Export" ? "active" : "")" asp-controller="Export" asp-action="Index">
                    <i class="bi bi-file-earmark-arrow-down"></i><span>Xuất Excel/PDF</span>
                    @if (!laPremium) { <i class="bi bi-lock-fill lock-icon"></i> }
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Household" ? "active" : "")" asp-controller="Household" asp-action="Index">
                    <i class="bi bi-people"></i><span>Gia đình</span>
                    @if (!laPremium) { <i class="bi bi-lock-fill lock-icon"></i> }
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Integrations" ? "active" : "")" asp-controller="Integrations" asp-action="Index">
                    <i class="bi bi-bank"></i><span>Kết nối NH/Ví</span>
                    @if (!laPremium) { <i class="bi bi-lock-fill lock-icon"></i> }
                </a>
            </nav>

            @if (!laPremium)
            {
                <div class="sidebar-upgrade">
                    <div class="upgrade-icon"><i class="bi bi-stars"></i></div>
                    <div class="upgrade-title">Nâng cấp Premium</div>
                    <div class="upgrade-desc">Mở khóa AI phân tích, OCR, xuất báo cáo &amp; nhiều hơn nữa</div>
                    <a asp-controller="Premium" asp-action="Pricing" class="btn btn-upgrade">Xem bảng giá</a>
                </div>
            }
        </aside>

        <div class="main-area @(!string.IsNullOrEmpty(appUser?.DuongDanAnhNen) ? "has-bg-image" : "")"
             style="@(!string.IsNullOrEmpty(appUser?.DuongDanAnhNen) ? $"background-image:url('{appUser.DuongDanAnhNen}');" : "")">
            <header class="topbar">
                <button class="btn-burger d-lg-none" onclick="document.getElementById('sidebar').classList.toggle('open')">
                    <i class="bi bi-list"></i>
                </button>
                <h1 class="page-title">@ViewData["Title"]</h1>

                <div id="clockWidget" class="clock-widget">
                    <span class="clock-icon"><i class="bi bi-sun-fill"></i></span>
                    <div class="clock-text">
                        <div class="clock-time" id="clockTime">--:--:--</div>
                        <div class="clock-date" id="clockDate">--/--/----</div>
                    </div>
                </div>

                <div class="topbar-right">
                    @if (laPremium)
                    {
                        <span class="badge-premium"><i class="bi bi-stars"></i> Premium</span>
                    }
                    <a asp-controller="Notifications" asp-action="Index" class="topbar-icon-btn position-relative" title="Thông báo">
                        <i class="bi bi-bell"></i>
                        @if (soChuaXemThongBao > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size:0.6rem;">
                                @(soChuaXemThongBao > 99 ? "99+" : soChuaXemThongBao.ToString())
                            </span>
                        }
                    </a>
                    <div class="dropdown">
                        <button class="user-chip" data-bs-toggle="dropdown">
                            @if (!string.IsNullOrEmpty(appUser?.DuongDanAnhDaiDien))
                            {
                                <img src="@appUser.DuongDanAnhDaiDien" alt="Avatar" class="user-avatar-img" />
                            }
                            else
                            {
                                <span class="user-avatar">@((appUser?.HoTen ?? appUser?.UserName ?? "U").Substring(0,1).ToUpper())</span>
                            }
                            <span class="d-none d-md-inline">
                                @(appUser?.HoTen ?? appUser?.UserName)
                                @if (appUser?.DaXacMinhDanhTinh == true)
                                {
                                    <i class="bi bi-patch-check-fill text-primary" title="Đã xác minh danh tính"></i>
                                }
                            </span>
                            <i class="bi bi-chevron-down small"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li><h6 class="dropdown-header">@(appUser?.Email)</h6></li>
                            <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-person-circle me-2"></i>Trang cá nhân</a></li>
                            <li><a class="dropdown-item" asp-controller="Settings" asp-action="Index"><i class="bi bi-gear me-2"></i>Cài đặt</a></li>
                            <li><a class="dropdown-item" asp-controller="Premium" asp-action="Pricing"><i class="bi bi-stars me-2"></i>Gói Premium</a></li>
                            <li><a class="dropdown-item" asp-controller="Contact" asp-action="Index"><i class="bi bi-envelope-heart me-2"></i>Liên hệ &amp; Đóng góp</a></li>
                            @if (laAdmin)
                            {
                                <li><a class="dropdown-item" asp-area="Admin" asp-controller="AdminHome" asp-action="Index"><i class="bi bi-shield-lock me-2"></i>Trang quản trị</a></li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <main class="content">
                @if (TempData["ThongBao"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle"></i> @TempData["ThongBao"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Loi"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle"></i> @TempData["Loi"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </main>

            <footer class="app-footer">
                © 2026 MoneyCare. Bảo lưu mọi quyền. ·
                <a href="mailto:support@moneycare.vn">support@moneycare.vn</a> ·
                <a asp-controller="Contact" asp-action="Index">Liên hệ &amp; Đóng góp</a>
            </footer>
        </div>
    </div>
}

    <partial name="_ChatbotWidget" />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js"></script>
    <script>
        // ==== Đồng hồ Widget: cập nhật mỗi giây, đổi cảnh ngày/đêm ====
        (function () {
            const elTime = document.getElementById('clockTime');
            const elDate = document.getElementById('clockDate');
            const widget = document.getElementById('clockWidget');
            if (!elTime) return;

            const tenThu = ['Chủ Nhật', 'Thứ Hai', 'Thứ Ba', 'Thứ Tư', 'Thứ Năm', 'Thứ Sáu', 'Thứ Bảy'];

            function capNhat() {
                const now = new Date();
                const gio = String(now.getHours()).padStart(2, '0');
                const phut = String(now.getMinutes()).padStart(2, '0');
                const giay = String(now.getSeconds()).padStart(2, '0');
                elTime.textContent = `${gio}:${phut}:${giay}`;
                elDate.textContent = `${tenThu[now.getDay()]}, ${String(now.getDate()).padStart(2,'0')}/${String(now.getMonth()+1).padStart(2,'0')}/${now.getFullYear()}`;

                const h = now.getHours();
                const laBanNgay = h >= 6 && h < 18;
                widget.classList.toggle('clock-day', laBanNgay);
                widget.classList.toggle('clock-night', !laBanNgay);
                widget.querySelector('.clock-icon').innerHTML = laBanNgay
                    ? '<i class="bi bi-sun-fill"></i>'
                    : '<i class="bi bi-moon-stars-fill"></i>';
            }
            capNhat();
            setInterval(capNhat, 1000);
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
